{
  "id": null,
  "uid": "ss-prod-v3",
  "title": "SearchSurge Overview",
  "tags": ["searchsurge"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Active Queries", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "expr": "searchsurge_active_entries", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 2, "title": "Ingest Rate (5m)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "rate(searchsurge_events_processed_total[5m])", "legendFormat": "{{status}}" }]
    },
    {
      "id": 3, "title": "P99 Latency", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "thresholds": { "steps": [{ "color": "green" }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.02 }] } } },
      "targets": [{ "expr": "histogram_quantile(0.99, rate(searchsurge_snapshot_latency_seconds_bucket[5m]))" }]
    },
    {
      "id": 5, "title": "Drop Rate & Ratio", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Dropped RPS" },
          "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 10 }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Drop Ratio" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "custom.axisLabel", "value": "Drop Ratio" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(searchsurge_events_processed_total{status=\"dropped\"}[5m])",
          "legendFormat": "dropped",
          "refId": "A"
        },
        {
          "expr": "rate(searchsurge_events_processed_total{status=\"dropped\"}[5m]) / rate(searchsurge_events_processed_total[5m])",
          "legendFormat": "Drop Ratio",
          "refId": "B"
        }
      ],
      "yAxes": [
        { "label": "Dropped RPS", "min": 0 },
        { "label": "Drop Ratio", "min": 0, "max": 1, "format": "percentunit" }
      ]
    },
    {
      "id": 4, "title": "Service Health", "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 12 },
      "targets": [{ "expr": "up{job=~\"searchsurge.*\"}", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true } } }]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": []
}