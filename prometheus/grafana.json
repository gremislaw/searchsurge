{
    "dashboard": {
      "id": null,
      "title": "SearchSurge Monitoring",
      "tags": ["searchsurge"],
      "timezone": "browser",
      "panels": [
        {
          "title": "P99 Snapshot Latency",
          "type": "graph",
          "targets": [
            {
              "expr": "histogram_quantile(0.99, rate(searchsurge_snapshot_latency_seconds_bucket[5m]))",
              "legendFormat": "P99"
            }
          ],
          "yaxes": [{"format": "s", "min": 0}],
          "thresholds": [{"value": 0.02, "colorMode": "critical"}]
        },
        {
          "title": "Ingest Rate & Drop Rate",
          "type": "graph",
          "targets": [
            {
              "expr": "rate(searchsurge_events_processed_total[1m])",
              "legendFormat": "processed {{status}}"
            },
            {
              "expr": "rate(searchsurge_ingest_dropped_total[1m])",
              "legendFormat": "dropped {{reason}}"
            }
          ],
          "yaxes": [{"format": "ops"}]
        },
        {
          "title": "Active Entries",
          "type": "stat",
          "targets": [
            {
              "expr": "searchsurge_active_entries",
              "legendFormat": "{{instance}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "steps": [
                  {"color": "green", "value": null},
                  {"color": "yellow", "value": 100},
                  {"color": "red", "value": 1000}
                ]
              }
            }
          }
        },
        {
          "title": "Service Health",
          "type": "table",
          "targets": [
            {
              "expr": "up{job=~\"searchsurge.*\"}",
              "format": "table",
              "instant": true
            }
          ],
          "transformations": [
            {"id": "organize", "options": {"excludeByName": {"Time": true, "Value #A": false}}}
          ]
        }
      ],
      "time": {"from": "now-1h", "to": "now"},
      "refresh": "10s"
    }
  }